{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solar-lens",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  // Poll both clouds every 5 minutes. SolisCloud itself only refreshes
  // roughly every 5 min, so faster polling buys nothing but rate-limit risk.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solar-lens",
      "database_id": "${CF_D1_DATABASE_ID}"
    }
  ],

  // Non-secret config. Secrets go in via `wrangler secret put`, never here.
  "vars": {
    // Solis "the on-grid plant" + SolarMan "the hybrid plant"; the shared Solis plant is skipped.
    "INCLUDE_PLANTS": "<your-solis-plant-id>,<your-solarman-station-id>"
  },

  "observability": {
    "enabled": true
  }
}
