{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solar-lens",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // No preview address per uploaded version: each would be one more public
  // host serving this Worker with the production database behind it. Deploys
  // go straight to production (npm run deploy), which never needed them.
  "preview_urls": false,

  // Poll both clouds every 5 minutes. SolisCloud itself only refreshes
  // roughly every 5 min, so faster polling buys nothing but rate-limit risk.
  // Once an hour, at seven minutes past, the slower work: the week's agents and
  // summary when due, the weather and the housekeeping (src/cron.ts hourly).
  // The two expressions are named in src/cron.ts; src/index.ts scheduled tells
  // them apart, so a change here is a change there too.
  "triggers": {
    "crons": ["*/5 * * * *", "7 * * * *"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Your D1 database. `npx wrangler d1 create solar-lens` prints the id; put it
  // in .dev.vars as CF_D1_DATABASE_ID rather than here, and scripts/wrangler.mjs
  // substitutes it into a gitignored copy of this file at run time - which is
  // why the npm scripts, not bare `npx wrangler`, are what you run. Keep the
  // binding name "DB": the Worker code reads env.DB.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solar-lens",
      "database_id": "${CF_D1_DATABASE_ID}"
    }
  ],

  // Per-account config such as INCLUDE_PLANTS (which plant ids to poll) is
  // deliberately NOT here so a fork carries nothing identifying. Set it with
  //   npx wrangler secret put INCLUDE_PLANTS
  // or as a variable in the Cloudflare dashboard; unset = every visible plant.

  // Workers AI, for Ask SolarLens and the weekly report (src/ai.ts). It only
  // ever runs on Cloudflare - "wrangler dev" reaches it remotely, and needs you
  // signed in to wrangler - and its free allowance is 10,000 neurons a day,
  // which AI_DAILY_CALLS keeps well inside. Remove this and those features
  // answer from the figures alone.
  "ai": {
    "binding": "AI"
  },

  // Optional: hold callers who are not signed in to a rate per address
  // (src/index.ts rateLimited) - a flood of anonymous requests could otherwise
  // spend D1's daily allowance. Uncomment if your plan offers Cloudflare's rate
  // limiting binding; without it nothing is limited, as before. The namespace
  // id is any number no other Worker on the account uses for a different limit.
  // "ratelimits": [
  //   { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  // ],

  "observability": {
    "enabled": true
  }
}
