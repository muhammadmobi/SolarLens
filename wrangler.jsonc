{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solar-lens",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  // Poll both clouds every 5 minutes. SolisCloud itself only refreshes
  // roughly every 5 min, so faster polling buys nothing but rate-limit risk.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Your D1 database. `npx wrangler d1 create solar-lens` prints the id - paste
  // it here. Keep the binding name "DB": the Worker code reads env.DB.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solar-lens",
      "database_id": "2cef68ef-0c26-4e7d-810c-81ae8bb8fb07"
    }
  ],

  // Per-account config such as INCLUDE_PLANTS (which plant ids to poll) is
  // deliberately NOT here so a fork carries nothing identifying. Set it with
  //   npx wrangler secret put INCLUDE_PLANTS
  // or as a variable in the Cloudflare dashboard; unset = every visible plant.

  "observability": {
    "enabled": true
  }
}
