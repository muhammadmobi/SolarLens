{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solar-lens",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,

  // Poll both clouds every 5 minutes. SolisCloud itself only refreshes
  // roughly every 5 min, so faster polling buys nothing but rate-limit risk.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Your D1 database. `npx wrangler d1 create solar-lens` prints the id; put it
  // in .dev.vars as CF_D1_DATABASE_ID rather than here, and scripts/wrangler.mjs
  // substitutes it into a gitignored copy of this file at run time - which is
  // why the npm scripts, not bare `npx wrangler`, are what you run. Keep the
  // binding name "DB": the Worker code reads env.DB.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solar-lens",
      "database_id": "${CF_D1_DATABASE_ID}"
    }
  ],

  // Per-account config such as INCLUDE_PLANTS (which plant ids to poll) is
  // deliberately NOT here so a fork carries nothing identifying. Set it with
  //   npx wrangler secret put INCLUDE_PLANTS
  // or as a variable in the Cloudflare dashboard; unset = every visible plant.

  // Workers AI, for Ask SolarLens and the weekly report (src/ai.ts). It only
  // ever runs on Cloudflare - "wrangler dev" reaches it remotely, and needs you
  // signed in to wrangler - and its free allowance is 10,000 neurons a day,
  // which AI_DAILY_CALLS keeps well inside. Remove this and those features
  // answer from the figures alone.
  "ai": {
    "binding": "AI"
  },

  "observability": {
    "enabled": true
  }
}
