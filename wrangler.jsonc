{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solar-lens",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  // Poll both clouds every 5 minutes. SolisCloud itself only refreshes
  // roughly every 5 min, so faster polling buys nothing but rate-limit risk.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solar-lens",
      "database_id": "2cef68ef-0c26-4e7d-810c-81ae8bb8fb07"
    }
  ],

  // Non-secret config. Secrets go in via `wrangler secret put`, never here.
  "vars": {
    // Solis "Solis Ongrid" + SolarMan "Nitrox Hybrid"; the shared Solis plant is skipped.
    "INCLUDE_PLANTS": "1298491919449414894,62034057"
  },

  "observability": {
    "enabled": true
  }
}
