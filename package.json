{
  "name": "solar-lens",
  "version": "2.8.0",
  "private": true,
  "description": "One screen for both inverters: SolisCloud + SolarMan, unified.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/wrangler.mjs dev",
    "deploy": "node scripts/wrangler.mjs deploy",
    "db:local": "node scripts/wrangler.mjs d1 migrations apply solar-lens --local",
    "db:remote": "node scripts/wrangler.mjs d1 migrations apply solar-lens --remote",
    "probe:solis": "node scripts/probe-solis.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "npm run typecheck && vitest run && playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "relay:solis": "node agent/solis-relay.mjs",
    "test:unit:coverage": "vitest run --coverage",
    "cf": "node scripts/wrangler.mjs"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
