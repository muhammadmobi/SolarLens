{
  "name": "solar-lens",
  "version": "0.1.0",
  "private": true,
  "description": "One screen for both inverters: SolisCloud + SolarMan, unified.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply solar-lens --local",
    "db:remote": "wrangler d1 migrations apply solar-lens --remote",
    "probe:solis": "node scripts/probe-solis.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "npm run typecheck && vitest run && playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "relay:solis": "node agent/solis-relay.mjs"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@playwright/test": "^1.63.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
