node_modules/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
dist/
*.log
.DS_Store
.env

# Pasted portal/DevTools responses - may contain session tokens
captures/

# Playwright capture browser profile (holds portal sessions)
.capture-profile/

# Test output
test-results/
playwright-report/

# Solis relay agent browser profile (holds your portal session)
.relay-profile/

# One-shot patch scripts used while developing; never part of the app
patch-*.mjs
.probe-*.mjs
coverage/

# Generated from wrangler.jsonc with your own ids filled in (scripts/wrangler.mjs)
.wrangler.local.jsonc

# The GitHub Pages demo, built by scripts/build-demo.mjs
site/

# The integration suite writes this from wrangler.jsonc with a made-up database id
.wrangler.it.jsonc

# Lighthouse reports, from the CI job or a local run
.lighthouseci/

# Screenshot baselines are recorded on Linux in CI; a local run records its own, not kept
tests/visual/__screenshots__/*
!tests/visual/__screenshots__/linux/
