# Copy to .dev.vars (gitignored) and fill in. Never commit real values.

# --- Cloudflare ---
# The id printed by `npx wrangler d1 create solar-lens`. Not a credential, but
# it identifies your account, so wrangler.jsonc holds a ${CF_D1_DATABASE_ID}
# placeholder and scripts/wrangler.mjs fills it in from here at run time.
# Without this line every `npm run dev|deploy|db:remote|cf` fails.
CF_D1_DATABASE_ID=

# --- SolisCloud: Service -> API Management -> Activate Now ---
SOLIS_KEY_ID=
SOLIS_KEY_SECRET=


# --- SolarMan official Business API: appId/appSecret from service@solarmanpv.com ---
SOLARMAN_APP_ID=
SOLARMAN_APP_SECRET=
SOLARMAN_EMAIL=
# sha256 hex of your SolarMan password (lowercase, no salt)
SOLARMAN_PASSWORD_SHA256=

# --- SolarMan web-session fallback (used only when the official keys above are absent) ---
# Log in to https://home.solarmanpv.com in a browser, then DevTools -> Application ->
# Cookies -> home.solarmanpv.com. Two cookies hold JWTs ("eyJ..."): the persistent
# one (expiry months out) is the refresh token, the Session one is the access
# token. Do not log out of that browser afterwards - it revokes both.
# Unofficial; may break whenever the portal changes.
SOLARMAN_WEB_REFRESH_TOKEN=
SOLARMAN_WEB_ACCESS_TOKEN=

# --- Which plants to poll (vendor plant/station ids, comma-separated). ---
# Unset = every plant the accounts can see, including plants shared into them.
# Find ids in the portal URL of a plant page (SolisCloud) or the station page (SolarMan).
INCLUDE_PLANTS=

# --- Shared secret gating /api/* and the local agent's /api/ingest ---
API_TOKEN=
INGEST_TOKEN=

# --- The secret every key is derived from (recommended) ---
# Signs sessions, peppers the password, seals the alert channels and the vendor
# tokens. Never sent anywhere, so replacing API_TOKEN no longer resets those.
# Unset = API_TOKEN does this job, as before 3.0. Generate one long random
# value and keep it: signed-in devices carry on through a change, but the
# password, the alert channels and a SolarMan web session would each have to
# be set again.
SECRET_KEY=

# --- The assistant's model (optional; see docs/ask-solarlens.md) ---
# Unset: Workers AI, through the "ai" binding. Set AI_BASE_URL and AI_MODEL to
# use any server that speaks OpenAI's chat API instead - https, or a model on
# this computer, such as Ollama at http://localhost:11434/v1 with AI_MODEL=llama3.1.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Model calls a day, every feature together (default 100).
AI_DAILY_CALLS=

# Worker origin the relay agent pushes to (agent/solis-relay.mjs reads this file)
SOLARLENS_URL=

# Which plants the relay agent pushes. Unset = every plant on the account,
# including any shared into it - set this if the account can see someone else's.
SOLIS_PLANT_IDS=

# --- Optional: the SolisCloud web login, so the relay can log in by itself ---
# When the relay's seven-day login runs out it logs in again with these, hidden.
# A window opens only if SolisCloud asks for a puzzle or a code.
# scripts/make-laptop-installer.ps1 carries them into the installer it writes.
# PLAIN TEXT: anyone who can read this file can log in to your SolisCloud.
# Setup writes them in single quotes ('like this'); one matching pair of quotes
# around a value is taken off when it is read, so a password is kept exactly.
SOLIS_USERNAME=
SOLIS_PASSWORD=

# Attach the relay to a Chrome you already have open, instead of it launching
# its own. Requires that Chrome to have been started with
#   chrome.exe --remote-debugging-port=9222
# Uses your own logins, but the relay's tab appears in your window and a
# debugging port lets any local program drive your browser. Leave unset to keep
# the separate profile.
RELAY_CDP=

# 1 hides the relay's browser when you run it by hand. The background task
# always runs hidden whatever this says, and renew-solis-login.cmd opens a
# window by itself when SolisCloud wants a login.
RELAY_HEADLESS=

# A nickname the dashboard shows for this relay, such as "Office laptop", beside
# its SolisCloud login expiry. Shown on a public page, so keep it vague. Unset:
# the dashboard calls it "Relay 1", "Relay 2" in the order relays first reported.
RELAY_NAME=

# Minutes between relay pushes (default 5), and an explicit Chrome binary if it
# is not installed in one of the usual places. Both optional.
RELAY_INTERVAL_MIN=
CHROME_PATH=
